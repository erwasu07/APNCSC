# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_USER: Custom admin login username (Default: admin)
ADMIN_USER="admin"

# ADMIN_PASS: Custom admin login password (Default: admin123)
ADMIN_PASS="admin123"

# ============================================================
# Official Meta WhatsApp Business Cloud API Configuration
# ============================================================
# 1. System User Permanent Access Token with 'whatsapp_business_messaging' and 'whatsapp_business_management' permissions
WHATSAPP_CLOUD_API_TOKEN=""

# 2. WhatsApp Phone Number ID (Found in Meta App Dashboard > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=""

# 3. WhatsApp Business Account (WABA) ID
WHATSAPP_WABA_ID=""

# 4. Meta Graph API Version (Default: v20.0)
META_GRAPH_API_VERSION="v20.0"

# 5. Meta App Secret (Used to verify X-Hub-Signature-256 on inbound delivery webhooks)
META_APP_SECRET=""

# 6. Webhook Verification Token (Custom secret string you configure in Meta App Dashboard > Configuration > Webhooks)
# Webhook Callback URL to enter in Meta Dashboard: https://www.cscdost.com/api/whatsapp/webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# 7. Authorized Test / Staff Recipient Phone (Mobile number with country code, e.g. 917006833767)
# Used to verify real Cloud API message delivery to your phone before sending to groups/contacts
WHATSAPP_TEST_RECIPIENT_PHONE="917006833767"

# 8. API-Managed Official Group ID (Only if your WABA account has official Groups API permission)
WHATSAPP_OFFICIAL_GROUP_ID=""

# 9. Optional: Pre-approved Meta Message Template Name for messaging outside 24h service window
WHATSAPP_POST_TEMPLATE_NAME=""

