{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{server.js,dist/**,index.html,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(post|job|jobs|sarkari|notice|admissions|notification|service|privacy-policy|terms-of-service|disclaimer|about-us|contact-us|refund-policy)/:path*",
      "destination": "/api"
    },
    {
      "source": "/(sitemap\\.xml|robots\\.txt)",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/thumbnails/(.*)",
      "destination": "/api"
    },
    {
      "source": "/og-image/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
