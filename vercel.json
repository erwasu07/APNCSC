{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{server.js,dist/**,index.html,public/**}"
    }
  },
  "routes": [
    {
      "src": "^/(.*)$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload"
      },
      "continue": true
    },
    {
      "src": "^/sw\\.js$",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8",
        "Service-Worker-Allowed": "/",
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "dest": "/api",
      "check": true
    },
    {
      "src": "^/index\\.html$",
      "dest": "/api",
      "check": true
    },
    {
      "src": "^/(sitemap\\.xml|robots\\.txt)$",
      "dest": "/api",
      "check": true
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api",
      "check": true
    },
    {
      "src": "^/thumbnails/(.*)$",
      "dest": "/api",
      "check": true
    },
    {
      "src": "^/og-image/(.*)$",
      "dest": "/api",
      "check": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/((?!assets/|csc-dost|favicon|apple-touch-icon|og-banner|manifest\\.json|site\\.webmanifest|sw\\.js|ads\\.txt|google[a-zA-Z0-9_-]+\\.html|.*\\.(?:js|mjs|css|png|jpg|jpeg|gif|webp|avif|svg|ico|woff|woff2|ttf|eot|map|pdf|txt|json|webmanifest)$).*)$",
      "dest": "/api",
      "check": true
    }
  ]
}
