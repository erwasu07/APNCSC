{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{server.js,dist/**,index.html,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/(sitemap\\.xml|robots\\.txt)",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/thumbnails/(.*)",
      "destination": "/api"
    },
    {
      "source": "/og-image/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/|csc-dost|favicon|apple-touch-icon|og-banner|manifest\\.json|site\\.webmanifest|sw\\.js|ads\\.txt|google[a-zA-Z0-9_-]+\\.html|.*\\.(?:js|mjs|css|png|jpg|jpeg|gif|webp|avif|svg|ico|woff|woff2|ttf|eot|map|pdf|txt|json|webmanifest)$).*)",
      "destination": "/api"
    }
  ]
}
