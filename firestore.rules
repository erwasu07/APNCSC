rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all for all unspecified collections/documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Applications collection (for customer applications & staff management)
    match /applications/{appId} {
      allow read: if true;
      allow create, update: if isValidId(appId);
      allow delete: if true;
    }

    // Appointments collection (for appointment bookings & staff management)
    match /appointments/{appId} {
      allow read: if true;
      allow create, update: if isValidId(appId);
      allow delete: if true;
    }
  }
}
